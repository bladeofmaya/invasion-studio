[
  {
    "name": "ffmpeg",
    "buildsystem": "autotools",
    "config-opts": [
      "--disable-doc",
      "--disable-debug",
      "--disable-autodetect",
      "--disable-network",
      "--disable-ffplay",
      "--enable-pthreads",
      "--enable-zlib",
      "--enable-vaapi",
      "--enable-libdrm"
    ],
    "post-install": [
      "install -Dm644 COPYING.LGPLv2.1 /app/share/licenses/ffmpeg/COPYING.LGPLv2.1"
    ],
    "sources": [
      {
        "type": "archive",
        "url": "https://ffmpeg.org/releases/ffmpeg-9.0.2.tar.xz",
        "sha256": "8c3850283eb25fa026482078a04051e0be17347b09ef81a0849bec15a96e002e"
      }
    ],
    "cleanup": [
      "/include",
      "/lib/pkgconfig",
      "/lib/*.a"
    ]
  },
  {
    "name": "leptonica",
    "buildsystem": "autotools",
    "config-opts": [
      "--disable-static",
      "--disable-programs"
    ],
    "post-install": [
      "install -Dm644 leptonica-license.txt /app/share/licenses/leptonica/LICENSE"
    ],
    "sources": [
      {
        "type": "archive",
        "url": "https://github.com/DanBloomberg/leptonica/releases/download/1.87.0/leptonica-1.87.0.tar.gz",
        "sha256": "c73363397f96eb1295602bf44d708a994ad42046c791bf03ea0505d829bdb6a7"
      }
    ],
    "cleanup": [
      "/include",
      "/lib/pkgconfig",
      "/lib/*.la"
    ]
  },
  {
    "name": "tesseract",
    "buildsystem": "cmake-ninja",
    "config-opts": [
      "-DCMAKE_BUILD_TYPE=Release",
      "-DBUILD_TRAINING_TOOLS=OFF",
      "-DBUILD_TESTS=OFF",
      "-DDISABLE_ARCHIVE=ON",
      "-DDISABLE_CURL=ON"
    ],
    "post-install": [
      "install -Dm644 ../LICENSE /app/share/licenses/tesseract/LICENSE"
    ],
    "sources": [
      {
        "type": "archive",
        "url": "https://github.com/tesseract-ocr/tesseract/archive/refs/tags/5.5.3.tar.gz",
        "sha256": "9218e62793116d42a9f6d14cd9348518b27f382096eea3d0f2d1a24616bb5884"
      }
    ],
    "cleanup": [
      "/include",
      "/lib/pkgconfig",
      "/lib/cmake",
      "/lib/*.a"
    ],
    "builddir": true
  },
  {
    "name": "english-ocr-data",
    "buildsystem": "simple",
    "build-commands": [
      "install -Dm644 eng.traineddata /app/share/tessdata/eng.traineddata",
      "install -Dm644 LICENSE /app/share/licenses/tessdata-fast/LICENSE"
    ],
    "sources": [
      {
        "type": "file",
        "url": "https://raw.githubusercontent.com/tesseract-ocr/tessdata_fast/4.1.0/eng.traineddata",
        "sha256": "7d4322bd2a7749724879683fc3912cb542f19906c83bcc1a52132556427170b2"
      },
      {
        "type": "file",
        "url": "https://raw.githubusercontent.com/tesseract-ocr/tessdata_fast/4.1.0/LICENSE",
        "sha256": "cfc7749b96f63bd31c3c42b5c471bf756814053e847c10f3eb003417bc523d30"
      }
    ]
  },
  {
    "name": "release-cleanup",
    "buildsystem": "simple",
    "build-commands": [
      "rm -rf /app/include /app/lib/pkgconfig /app/lib/cmake /app/lib/debug",
      "find /app/lib -maxdepth 1 -type f \\( -name \"*.a\" -o -name \"*.la\" \\) -delete"
    ],
    "sources": []
  }
]
