<div class="player-edit-controls" id="video-controls" data-video-player-target="controls" style="display:none;">
  <div class="timeline-toolbar player-file-toolbar">
    <button type="button" class="player-file-button" data-action="click->video-player#revealFile" aria-label="Reveal File" title="Reveal file in its folder">
      <i data-lucide="file-video" class="size-3.5"></i>
      <span id="meta-filename" data-video-player-target="filename">File</span>
    </button>
    <label>Audio:
      <select data-video-player-target="audioTrack" data-action="change->video-player#changeAudioTrack">
        <option value="4" selected>Track 4</option>
      </select>
    </label>
    <button type="button" data-action="click->video-player#fullscreen">Fullscreen editor</button>
  </div>
  <div data-video-player-target="timelineEditor"></div>
  <p class="px-4 py-2 text-xs text-text-muted" role="status" data-video-player-target="markerStatus" hidden></p>
</div>
