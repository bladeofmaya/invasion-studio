<div class="flex flex-col min-h-0 overflow-hidden bg-app-bg" id="clip-panel" data-navigation-target="clipPanel" data-controller="clip-list" data-clip-list-view-value="all" data-clip-list-filter-value="unassigned" data-clip-list-sort-value="" data-clip-list-group-value="" data-clip-list-selected-clip-id-value="">
  <div class="px-4 py-3 border-b border-border flex flex-wrap items-center gap-2" data-clip-list-target="toolbar">
    <h2 class="m-0 text-base text-text-muted" data-clip-list-target="panelTitle">Clips</h2>
    <span class="bg-surface-secondary text-text-muted border border-border rounded-full px-2.5 py-1 text-xs font-medium" style="display:none" data-clip-list-target="clipCount" id="clip-count">0</span>
    <div class="block" data-clip-list-target="filterDropdown" id="filter-dropdown">
      <select class="bg-input-bg text-text-primary border border-input-border px-3 py-1.5 rounded-full text-sm cursor-pointer focus:outline-none focus:border-input-focus-ring" data-clip-list-target="filterSelect" data-action="change->clip-list#setFilter" id="clip-filter">
        <option value="everything">Everything</option>
        <option value="unassigned" selected>Unassigned</option>
        <option value="assigned">Assigned</option>
        <option value="deleted">Trash</option>
      </select>
    </div>
    <div class="block" data-clip-list-target="sortDropdown" id="sort-dropdown">
      <select class="bg-input-bg text-text-primary border border-input-border px-3 py-1.5 rounded-full text-sm cursor-pointer focus:outline-none focus:border-input-focus-ring" data-clip-list-target="sortSelect" data-action="change->clip-list#setSort" id="clip-sort">
        <option value="" selected>Default order</option>
        <option value="newest">Newest</option>
        <option value="oldest">Oldest</option>
        <option value="rating-desc">Rating &#8595;</option>
        <option value="rating-asc">Rating &#8593;</option>
        <option value="title">Title</option>
        <option value="duration-desc">Longest</option>
        <option value="duration-asc">Shortest</option>
      </select>
    </div>
    <div class="clip-view-toggle" role="group" aria-label="Clip list view">
      <button type="button" data-clip-list-target="viewMode" data-compact="false" data-action="click->clip-list#setViewMode" aria-pressed="true" aria-label="Extended view" title="Extended view — background images"><i data-lucide="panels-top-left" aria-hidden="true"></i></button>
      <button type="button" data-clip-list-target="viewMode" data-compact="true" data-action="click->clip-list#setViewMode" aria-pressed="false" aria-label="Compact view" title="Compact view — condensed list"><i data-lucide="list" aria-hidden="true"></i></button>
    </div>
    <button type="button" class="bg-danger text-danger-fg border-none px-3 py-1.5 rounded text-xs font-semibold cursor-pointer hover:bg-danger-hover" style="display:none" data-clip-list-target="emptyTrashBtn" data-action="click->clip-list#emptyTrash" id="empty-trash-btn">Empty Trash</button>
    <div class="hidden gap-2 items-center" data-clip-list-target="groupExport" id="group-export-controls">
      <button type="button" class="inline-flex items-center gap-1.5 bg-surface-secondary text-text-secondary border border-border px-3 py-1 rounded-full text-xs cursor-pointer hover:bg-surface-hover hover:text-text-primary" data-clip-list-target="revealExportButton" data-action="click->clip-list#revealExport" title="Open the export directory" hidden>
        <i data-lucide="folder-open" class="size-3.5"></i>
        <span>Reveal Export Folder</span>
      </button>
      <button class="bg-primary text-primary-fg border-none px-4 py-1.5 rounded text-sm font-semibold cursor-pointer hover:bg-primary-hover" data-clip-list-target="exportButton" data-action="click->clip-list#exportGroup">Export</button>
    </div>
  </div>
  <div class="px-4 py-2 border-b border-border flex flex-wrap gap-2 items-center" data-clip-list-target="searchControls" id="search-controls">
    <input type="search" class="bg-input-bg text-text-primary border border-input-border px-3 py-1 rounded-full text-xs flex-1 min-w-32 focus:outline-none focus:border-input-focus-ring" id="clip-search" placeholder="Search title, note or filename..." autocomplete="off" data-clip-list-target="searchInput" data-action="input->clip-list#setSearch">
    <select class="bg-input-bg text-text-primary border border-input-border px-2.5 py-1 rounded-full text-xs cursor-pointer focus:outline-none focus:border-input-focus-ring" data-clip-list-target="tagFilter" data-action="change->clip-list#setTagFilter" id="clip-tag-filter">
      <option value="">All tags</option>
      <option value="__none__">Untagged</option>
    </select>
    <select class="bg-input-bg text-text-primary border border-input-border px-2.5 py-1 rounded-full text-xs cursor-pointer focus:outline-none focus:border-input-focus-ring" data-clip-list-target="ratingFilter" data-action="change->clip-list#setRatingFilter" id="clip-rating-filter">
      <option value="">Any rating</option>
      <option value="__none__">Unrated</option>
      <option value="1">&#9733; 1+</option>
      <option value="2">&#9733; 2+</option>
      <option value="3">&#9733; 3+</option>
      <option value="4">&#9733; 4+</option>
      <option value="5">&#9733; 5</option>
    </select>
    <select class="bg-input-bg text-text-primary border border-input-border px-2.5 py-1 rounded-full text-xs cursor-pointer focus:outline-none focus:border-input-focus-ring" data-clip-list-target="resultFilter" data-action="change->clip-list#setResultFilter" id="clip-result-filter">
      <option value="">Any result</option>
      <option value="__none__">No result</option>
      <option value="win">Win</option>
      <option value="loss">Loss</option>
      <option value="dc">DC</option>
    </select>
    <button type="button" class="bg-transparent text-text-muted border border-transparent px-2 py-1 rounded-full text-xs cursor-pointer hover:text-text-primary underline" style="display:none" data-clip-list-target="clearFiltersBtn" data-action="click->clip-list#clearFilters" id="clear-filters">Clear filters</button>
    <div class="clip-active-filters" data-clip-list-target="activeFilters" aria-label="Active filters" hidden></div>
  </div>
  <div class="flex-1 overflow-y-auto px-4 py-3 min-h-0" data-clip-list-target="container" id="clip-list"></div>
  <div class="flex-1 overflow-y-auto p-4 grid grid-cols-[repeat(auto-fill,minmax(min(100%,420px),1fr))] gap-4 content-start hidden" data-controller="group-manager" data-group-manager-target="grid" data-navigation-target="groupGrid" id="group-grid">
    <div class="compilation-toolbar">
      <div class="compilation-tabs" role="group" aria-label="Compilation status">
        <button type="button" aria-pressed="true" data-group-manager-target="archiveTab" data-archived="false" data-action="click->group-manager#switchArchive">Active</button>
        <button type="button" aria-pressed="false" data-group-manager-target="archiveTab" data-archived="true" data-action="click->group-manager#switchArchive">Archived</button>
      </div>
      <input type="search" aria-label="Search compilations" placeholder="Search compilations…" data-group-manager-target="search" data-action="input->group-manager#render">
      <select aria-label="Sort compilations" data-group-manager-target="sort" data-action="change->group-manager#render">
        <option value="updated">Recently updated</option>
        <option value="name">Name</option>
        <option value="archived" hidden>Recently archived</option>
      </select>
      <button type="button" class="compilation-create" data-group-manager-target="newGroupCard" data-action="click->group-manager#showNewGroupForm">+ New compilation</button>
    </div>
    <form class="col-span-full bg-surface border border-accent rounded-lg p-5" data-group-manager-target="newGroupForm" data-action="submit->group-manager#createGroup" id="new-group-inline-form" hidden>
      <label class="block text-sm font-medium text-text-primary mb-2" for="new-group-name">New compilation</label>
      <input type="text" maxlength="100" class="block w-full bg-input-bg text-text-primary border border-input-border px-3 py-2 rounded text-sm mb-3 focus:outline-none focus:border-input-focus-ring" id="new-group-name" data-group-manager-target="newGroupInput" placeholder="Compilation name" autocomplete="off">
      <div class="flex gap-2 items-center justify-start">
        <button type="submit" class="bg-primary text-primary-fg border-none px-4 py-2 rounded text-sm font-medium cursor-pointer hover:bg-primary-hover whitespace-nowrap">Create compilation</button>
        <button type="button" class="bg-transparent border border-text-muted text-text-muted px-4 py-2 rounded text-sm cursor-pointer hover:border-text-primary hover:text-text-primary" data-action="click->group-manager#cancelNewGroupForm">Cancel</button>
      </div>
    </form>
  </div>
</div>
