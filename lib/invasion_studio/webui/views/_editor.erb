<div class="px-4 py-3 flex-shrink-0 flex flex-col bg-surface-overlay text-text-primary border-b border-border" data-controller="editor" data-editor-clip-id-value="" data-action="video-player:cuts-saved@window->editor#updateFinalizeButton">
  <div class="flex justify-between items-center mb-1.5">
    <input type="text" class="flex-1 bg-transparent border-none text-text-primary font-semibold text-xl focus:outline-none" id="title-input" data-editor-target="titleInput" placeholder="Clip title (optional)" disabled data-action="blur->editor#debouncedSaveTitle">
    <button class="bg-primary text-primary-fg border-none px-3 py-1.5 text-xs rounded cursor-pointer ml-2 hover:bg-primary-hover" id="finalize-btn" data-editor-target="finalizeBtn" data-action="click->editor#finalizeCuts" style="display:none">Finalize Cuts</button>
    <button class="bg-danger text-danger-fg border-none px-3 py-1.5 text-xs rounded cursor-pointer ml-2 hover:bg-danger-hover" id="delete-btn" data-editor-target="deleteBtn" data-action="click->editor#deleteClip" style="display:none" aria-label="Delete">
      <i data-lucide="trash-2" class="size-4"></i>
    </button>
    <button class="bg-transparent border border-text-muted text-text-muted px-4 py-1.5 text-xs rounded cursor-pointer ml-auto hover:border-text-primary hover:text-text-primary" id="restore-btn" data-editor-target="restoreBtn" data-action="click->editor#restoreClip" style="display:none">Restore</button>
  </div>
    <textarea class="bg-input-bg text-text-primary border border-input-border rounded p-3 text-base leading-snug resize-none mb-3 focus:outline-none focus:border-input-focus-ring" id="note-input" rows="2" data-editor-target="noteInput" placeholder="Add a note about this clip..." disabled data-action="blur->editor#debouncedSaveNote"></textarea>
  <div class="flex flex-wrap gap-1.5 mb-3 items-center" id="editor-tags" data-action="click->editor#removeTag">
    <i data-lucide="tag" class="size-3.5 text-text-muted"></i>
    <span class="contents" data-editor-target="tagList"></span>
    <input type="text" list="tag-suggestions" class="bg-transparent text-text-primary border border-transparent focus:border-input-border rounded px-2 py-0.5 text-xs w-28 focus:outline-none" placeholder="Add tag..." data-editor-target="tagInput" disabled data-action="keydown.enter->editor#addTag change->editor#addTag">
    <datalist id="tag-suggestions" data-editor-target="tagSuggestions"></datalist>
  </div>
  <div class="flex flex-wrap gap-3 mb-1.5 text-sm text-text-muted items-center">
    <div class="flex gap-1 cursor-pointer text-[1.75rem] leading-none" id="editor-rating" data-editor-target="ratingContainer" data-action="click->editor#setRating">
      <span class="text-star-empty transition-colors hover:text-accent-hover" data-value="1">★</span>
      <span class="text-star-empty transition-colors hover:text-accent-hover" data-value="2">★</span>
      <span class="text-star-empty transition-colors hover:text-accent-hover" data-value="3">★</span>
      <span class="text-star-empty transition-colors hover:text-accent-hover" data-value="4">★</span>
      <span class="text-star-empty transition-colors hover:text-accent-hover" data-value="5">★</span>
    </div>
    <label class="flex gap-2 items-center text-sm text-text-muted" for="editor-result">
      <select class="bg-input-bg text-text-primary border border-input-border px-3 py-1.5 rounded-full text-sm cursor-pointer focus:outline-none focus:border-input-focus-ring" id="editor-result" data-editor-target="resultSelect" data-action="change->editor#setResult" disabled>
        <option value="" selected>Result...</option>
        <option value="win">Win</option>
        <option value="loss">Loss</option>
        <option value="dc">DC</option>
      </select>
    </label>
    <button type="button" class="inline-flex items-center gap-1.5 bg-surface-secondary text-text-secondary border border-border px-3 py-1 rounded-full text-xs cursor-pointer hover:bg-surface-hover hover:text-text-primary" data-action="click->video-player#revealFile" title="Reveal file in its folder">
      <i data-lucide="file-video" class="size-3.5"></i>
      <span id="meta-filename" data-video-player-target="filename">File</span>
    </button>
    <button type="button" class="inline-flex items-center gap-1.5 bg-surface-secondary text-text-secondary border border-border px-3 py-1 rounded-full text-xs cursor-pointer hover:bg-surface-hover hover:text-text-primary" data-action="click->video-player#revealFile" title="Reveal file in its folder">
      <i data-lucide="folder-open" class="size-3.5"></i>
      <span>Reveal File</span>
    </button>
  </div>
</div>
