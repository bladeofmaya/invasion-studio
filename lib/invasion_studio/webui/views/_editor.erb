<header class="clip-card-header text-text-primary" aria-label="Clip details" data-controller="editor" data-editor-clip-id-value="">
  <div class="clip-heading-row">
    <input type="text" class="clip-title-input" aria-label="Clip title" id="title-input" data-editor-target="titleInput" placeholder="Clip title (optional)" disabled data-action="blur->editor#debouncedSaveTitle">
    <div class="clip-file-actions">
      <button type="button" class="player-file-button" data-action="click->video-player#revealFile" aria-label="Reveal File" title="Reveal file in its folder">
        <i data-lucide="file-video" class="size-3.5"></i>
        <span id="meta-filename" data-video-player-target="filename">File</span>
      </button>
      <button type="button" class="clip-delete-button" id="delete-btn" data-editor-target="deleteBtn" data-action="click->editor#deleteClip" style="display:none" aria-label="Delete clip" title="Move clip to trash">
        <i data-lucide="trash-2" class="size-4"></i>
      </button>
      <button class="bg-transparent border border-text-muted text-text-muted px-4 py-1.5 text-xs rounded cursor-pointer hover:border-text-primary hover:text-text-primary" id="restore-btn" data-editor-target="restoreBtn" data-action="click->editor#restoreClip" style="display:none">Restore</button>
    </div>
  </div>
  <textarea class="clip-description" id="note-input" rows="1" aria-label="Description" data-editor-target="noteInput" placeholder="Add a description about this clip..." disabled data-action="blur->editor#debouncedSaveNote"></textarea>
  <div class="clip-metadata-row">
    <div class="clip-metadata-fields">
      <label class="flex gap-2 items-center text-sm text-text-muted" for="editor-result">
        <select class="bg-input-bg text-text-primary border border-input-border px-2 py-1 rounded text-xs cursor-pointer focus:outline-none focus:border-input-focus-ring" id="editor-result" aria-label="Status" data-editor-target="resultSelect" data-action="change->editor#setResult" disabled>
          <option value="" selected>Result...</option>
          <option value="win">Win</option>
          <option value="loss">Loss</option>
          <option value="dc">DC</option>
        </select>
      </label>
      <div class="flex gap-1 cursor-pointer text-xl leading-none" id="editor-rating" data-editor-target="ratingContainer" data-action="click->editor#setRating">
        <span class="text-star-empty transition-colors hover:text-accent-hover" data-value="1">★</span>
        <span class="text-star-empty transition-colors hover:text-accent-hover" data-value="2">★</span>
        <span class="text-star-empty transition-colors hover:text-accent-hover" data-value="3">★</span>
        <span class="text-star-empty transition-colors hover:text-accent-hover" data-value="4">★</span>
        <span class="text-star-empty transition-colors hover:text-accent-hover" data-value="5">★</span>
      </div>
      <div class="clip-tags flex flex-wrap gap-1.5 items-center" id="editor-tags" data-action="click->editor#removeTag">
        <i data-lucide="tag" class="size-3.5 text-text-muted"></i>
        <span class="contents" data-editor-target="tagList"></span>
        <span class="relative">
          <input type="text" autocomplete="off" class="bg-transparent text-text-primary border border-transparent focus:border-input-border rounded px-2 py-0.5 text-xs w-28 focus:outline-none" placeholder="Add tag..." data-editor-target="tagInput" disabled data-action="input->editor#tagInputChanged focus->editor#tagInputChanged keydown->editor#tagKeydown blur->editor#hideTagSuggestions">
          <div class="absolute left-0 top-full z-40 mt-1 min-w-32 max-h-48 overflow-y-auto bg-surface border border-border rounded shadow-lg" hidden data-editor-target="tagSuggestions" data-action="mousedown->editor#pickTagSuggestion"></div>
        </span>
      </div>
    </div>

  </div>
</header>
