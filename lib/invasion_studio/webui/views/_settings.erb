<div class="fixed inset-0 z-50 bg-black/60 items-center justify-center" style="display:none" data-settings-target="overlay" data-action="click->settings#backdropClose">
  <div class="bg-surface border border-border rounded-lg w-[40rem] max-w-[90vw] shadow-lg overflow-hidden">
    <div class="flex items-center justify-between px-4 py-3 border-b border-border">
      <h3 class="m-0 text-base font-semibold text-text-primary">Settings</h3>
      <button type="button" class="inline-flex items-center justify-center bg-transparent text-text-muted border-none p-1 rounded cursor-pointer hover:text-text-primary" data-action="click->settings#close" aria-label="Close settings">
        <i data-lucide="x" class="size-4"></i>
      </button>
    </div>
    <div class="flex h-[36rem] max-h-[80vh]">
      <div class="w-36 shrink-0 border-r border-border p-2 flex flex-col gap-1">
        <button type="button" class="flex items-center gap-2 px-3 py-2 rounded text-sm text-left cursor-pointer border-none bg-surface-hover text-text-primary" data-settings-target="tab" data-category="tags" data-action="click->settings#switchCategory">
          <i data-lucide="tag" class="size-4"></i><span>Tags</span>
        </button>
        <button type="button" class="flex items-center gap-2 px-3 py-2 rounded text-sm text-left cursor-pointer border-none bg-transparent text-text-muted hover:bg-surface-hover hover:text-text-primary" data-settings-target="tab" data-category="storage" data-action="click->settings#switchCategory">
          <i data-lucide="database" class="size-4"></i><span>Storage</span>
        </button>
        <button type="button" class="flex items-center gap-2 px-3 py-2 rounded text-sm text-left cursor-pointer border-none bg-transparent text-text-muted hover:bg-surface-hover hover:text-text-primary" data-settings-target="tab" data-category="video" data-action="click->settings#switchCategory">
          <i data-lucide="video" class="size-4"></i><span>Video</span>
        </button>
        <button type="button" class="flex items-center gap-2 px-3 py-2 rounded text-sm text-left cursor-pointer border-none bg-transparent text-text-muted hover:bg-surface-hover hover:text-text-primary" data-settings-target="tab" data-category="stats" data-action="click->settings#switchCategory">
          <i data-lucide="chart-no-axes-column" class="size-4"></i><span>Stats</span>
        </button>
      </div>
      <div class="flex-1 min-w-0 overflow-y-auto p-4" data-settings-target="panel" data-category="tags">
        <div class="flex flex-col gap-2" data-settings-target="tagList"></div>
      </div>
      <div class="flex-1 min-w-0 overflow-y-auto p-4" data-settings-target="panel" data-category="storage" hidden>
        <div data-settings-target="storagePanel"></div>
      </div>
      <div class="flex-1 min-w-0 overflow-y-auto p-4" data-settings-target="panel" data-category="video" hidden>
        <div class="flex flex-col gap-5 max-w-sm">
          <div>
            <label for="audio-track-count" class="block text-sm font-medium text-text-primary mb-1.5">Audio tracks per clip</label>
            <input id="audio-track-count" type="number" min="1" max="32" step="1" class="w-full box-border bg-input-bg text-text-primary border border-input-border px-3 py-2 rounded text-sm focus:outline-none focus:border-input-focus-ring" data-settings-target="audioTrackCount" data-action="input->settings#updateDefaultAudioTrackOptions">
            <p class="text-xs text-text-muted mt-1.5 mb-0">The number of selectable audio tracks shown in the clip player.</p>
          </div>
          <div>
            <label for="default-audio-track" class="block text-sm font-medium text-text-primary mb-1.5">Default audio track</label>
            <select id="default-audio-track" class="w-full bg-input-bg text-text-primary border border-input-border px-3 py-2 rounded text-sm" data-settings-target="defaultAudioTrack"></select>
            <p class="text-xs text-text-muted mt-1.5 mb-0">This track is selected whenever a clip is opened.</p>
          </div>
          <div class="flex items-center gap-3">
            <button type="button" class="bg-primary text-primary-fg border-none px-4 py-2 rounded text-sm cursor-pointer hover:bg-primary-hover" data-action="click->settings#saveVideoSettings">Save</button>
            <span class="text-xs text-text-muted" data-settings-target="videoStatus"></span>
          </div>
        </div>
      </div>
      <div class="flex-1 min-w-0 overflow-y-auto p-4" data-settings-target="panel" data-category="stats" hidden>
        <div data-settings-target="statsPanel"></div>
      </div>
    </div>
  </div>
</div>
