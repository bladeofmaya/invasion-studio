<section class="min-h-0 overflow-y-auto p-6" data-navigation-target="importPanel" style="display:none">
  <div class="max-w-3xl mx-auto space-y-6">
    <section class="bg-surface border border-border rounded-lg p-5">
      <h2 class="m-0 mb-2 flex items-center gap-2 text-base font-semibold"><i data-lucide="upload" class="size-5 shrink-0 text-accent" aria-hidden="true"></i><span>Upload clips</span></h2>
      <p class="m-0 mb-4 text-sm text-text-muted">Already have individual clips? Select multiple files to copy them into your library.</p>
      <%= erb :_import_upload %>
    </section>
    <section class="bg-surface border border-border rounded-lg p-5" data-controller="extraction">
      <h2 class="m-0 mb-2 flex items-center gap-2 text-base font-semibold"><i data-lucide="scissors" class="size-5 shrink-0 text-accent" aria-hidden="true"></i><span>Extract from recordings</span></h2>
      <p class="m-0 mb-4 text-sm text-text-muted">Detect invasions and extract clips from one or more gameplay recordings. Original recordings stay in place.</p>
      <form data-action="submit->extraction#start">
        <fieldset class="border-0 p-0 m-0 min-w-0 space-y-4 disabled:opacity-50" data-extraction-target="fields" disabled>
          <button type="button" class="bg-surface-secondary text-text-primary border border-border px-4 py-2 rounded text-sm cursor-pointer hover:bg-surface-hover" data-extraction-target="picker" data-action="click->extraction#chooseRecordings" hidden>Choose recordings</button>
          <div>
            <label for="recording-paths" class="block text-sm font-medium mb-2">Recording paths, one per line</label>
            <textarea id="recording-paths" rows="4" required spellcheck="false" class="block w-full bg-input-bg text-text-primary border border-input-border rounded p-3 text-sm focus:outline-none focus:border-input-focus-ring" placeholder="/home/you/Videos/recording-001.mp4" data-extraction-target="paths"></textarea>
            <p class="m-0 mt-2 text-xs text-text-muted">Files must be on the computer running Invasion Studio. Arrange them in playback order so invasions can span recordings. Enter individual paths without quotes or wildcards.</p>
          </div>
          <% extraction_settings = InvasionStudio::Webui::ExtractionRequest.validate_options(project.extraction_settings) %>
          <details data-action="change->extraction#saveSettings">
            <summary class="text-sm cursor-pointer text-text-secondary">Extraction settings</summary>
            <div class="grid grid-cols-2 gap-4 mt-4">
              <% [['threads', 'FFmpeg threads', extraction_settings[:ffmpeg_threads], 1, 64, 1], ['workers', 'OCR workers', extraction_settings[:ocr_workers], 1, 64, 1], ['fps', 'Frames scanned per second', extraction_settings[:fps], 1, 10, 1], ['padStart', 'Seconds before invasion', extraction_settings[:pad_start], 0, 3600, 0.5], ['padEnd', 'Seconds after invasion', extraction_settings[:pad_end], 0, 3600, 0.5]].each do |target, label, value, minimum, maximum, step| %>
                <label class="block text-sm text-text-secondary"><%= label %>
                  <input type="number" required value="<%= value %>" min="<%= minimum %>" max="<%= maximum %>" step="<%= step %>" class="block w-full mt-1 bg-input-bg text-text-primary border border-input-border rounded px-3 py-2" data-extraction-target="<%= target %>">
                </label>
              <% end %>
            </div>
            <label class="flex gap-2 items-center mt-4 text-sm"><input type="checkbox" data-extraction-target="hwaccel" <%= 'checked' if extraction_settings[:hwaccel] %>>Hardware acceleration (VAAPI, supported Linux GPUs)</label>
            <label class="flex gap-2 items-center mt-3 text-sm"><input type="checkbox" data-extraction-target="noCache" <%= 'checked' if extraction_settings[:no_cache] %>>Rescan recordings instead of using cached detection</label>
            <p class="m-0 mt-3 text-xs text-text-muted" role="status" data-extraction-target="settingsStatus">Settings are saved automatically for this project.</p>
          </details>
          <label class="flex gap-2 items-center text-sm"><input type="checkbox" data-extraction-target="allowReimport">Import again even if these recordings were previously imported (creates duplicate clips)</label>
          <button type="submit" class="bg-primary text-primary-fg border-none px-4 py-2 rounded text-sm font-semibold cursor-pointer hover:bg-primary-hover">Extract clips</button>
        </fieldset>
      </form>
      <div class="mt-4 text-sm text-text-muted" role="status" aria-live="polite" data-extraction-target="status">Checking extraction status…</div>
      <progress class="w-full mt-3" data-extraction-target="progress" hidden></progress>
      <p class="m-0 mt-3 text-xs text-text-muted">You can switch tabs while extraction runs. Keep the application open until it finishes. Previously imported recordings are blocked unless you select Import again. Duplicate checks apply to recordings imported through this tab from now on.</p>
      <button type="button" class="mt-4 bg-surface-secondary text-text-primary border border-border px-4 py-2 rounded text-sm cursor-pointer hover:bg-surface-hover" data-extraction-target="viewClips" data-action="click->extraction#viewClips" hidden>View imported clips</button>
    </section>
  </div>
</section>
