<header class="bg-surface border-b border-border px-4 py-3 flex items-center gap-2 shrink-0">
  <div class="text-lg font-bold text-accent tracking-tight mr-4">Invasion Studio</div>
  <div class="flex gap-1">
    <div class="px-4 py-2 rounded cursor-pointer bg-surface-secondary text-text-muted text-sm transition-all whitespace-nowrap hover:bg-surface-hover hover:text-text-primary data-[active]:bg-surface-hover data-[active]:text-text-primary data-[active]:font-semibold data-[active]:shadow-[inset_0_-2px_0_var(--color-accent)]" data-navigation-target="tab" data-view="all" data-action="click->navigation#switchView">Clips</div>
    <div class="px-4 py-2 rounded cursor-pointer bg-surface-secondary text-text-muted text-sm transition-all whitespace-nowrap hover:bg-surface-hover hover:text-text-primary data-[active]:bg-surface-hover data-[active]:text-text-primary data-[active]:font-semibold data-[active]:shadow-[inset_0_-2px_0_var(--color-accent)]" data-navigation-target="tab" data-view="groups" data-action="click->navigation#switchView">Compilations</div>
  </div>
  <button class="bg-surface-secondary text-text-primary border-none px-4 py-2 rounded text-sm cursor-pointer mr-2 hover:bg-surface-hover" data-navigation-target="backBtn" data-action="click->navigation#goBack" style="display:none">&larr; Back</button>
  <button type="button" class="ml-auto inline-flex items-center justify-center bg-surface-secondary text-text-secondary border border-border p-2 rounded-full cursor-pointer hover:bg-surface-hover hover:text-text-primary" data-controller="theme" data-action="click->theme#toggle" aria-label="Switch color theme"></button>
  <div class="inline-flex" data-controller="settings">
    <button type="button" class="inline-flex items-center justify-center bg-surface-secondary text-text-secondary border border-border p-2 rounded-full cursor-pointer hover:bg-surface-hover hover:text-text-primary" data-action="click->settings#open" aria-label="Settings" title="Settings">
      <i data-lucide="settings" class="size-4"></i>
    </button>
    <%= erb :_settings %>
  </div>
  <div class="inline-flex" data-controller="info">
    <button type="button" class="inline-flex items-center justify-center bg-surface-secondary text-text-secondary border border-border p-2 rounded-full cursor-pointer hover:bg-surface-hover hover:text-text-primary" data-action="click->info#open" aria-label="About Invasion Studio" title="About Invasion Studio">
      <i data-lucide="info" class="size-4"></i>
    </button>
    <div class="fixed inset-0 z-50 bg-black/60 items-center justify-center" style="display:none" data-info-target="overlay" data-action="click->info#backdropClose">
      <div class="bg-surface border border-border rounded-lg p-6 w-96 max-w-[90vw] shadow-lg">
        <img src="/images/logo.png" alt="Invasion Studio logo" class="block size-20 rounded-full mx-auto mb-4">
        <h3 class="m-0 mb-1 text-base font-semibold text-text-primary text-center">Invasion Studio</h3>
        <div class="text-xs text-text-muted text-center mb-4">Version <%= InvasionStudio::VERSION %></div>
        <p class="m-0 mb-3 text-sm text-text-muted text-center">This software is released under the <a href="https://github.com/bladeofmaya/invasion-studio/blob/master/MIT-LICENSE" target="_blank" rel="noopener" class="text-accent no-underline hover:underline">MIT license</a>. If you paid for this software, congratulations, you've been scammed.</p>
        <p class="m-0 mb-4 text-sm text-text-muted text-center">If you like and want to support my work make sure to follow and subscribe to my channels.</p>
        <div class="mb-4 flex flex-wrap justify-center items-center gap-x-2 gap-y-1 text-sm text-text-muted">
          <a href="https://github.com/bladeofmaya/invasion-studio" target="_blank" rel="noopener" class="text-accent no-underline hover:underline">GitHub</a>
          <span>&middot;</span>
          <a href="https://x.com/bladeofmaya" target="_blank" rel="noopener" class="text-accent no-underline hover:underline">X</a>
          <span>&middot;</span>
          <a href="https://www.twitch.tv/bladeofmaya" target="_blank" rel="noopener" class="text-accent no-underline hover:underline">Twitch</a>
          <span>&middot;</span>
          <a href="https://www.youtube.com/@bladeofmaya" target="_blank" rel="noopener" class="text-accent no-underline hover:underline">YouTube</a>
          <span>&middot;</span>
          <a href="https://bonfire.bladeofmaya.com/join/h7O0-ZdEu-L58f" target="_blank" rel="noopener" class="text-accent no-underline hover:underline">Bonfire</a>
        </div>
        <div class="flex justify-center">
          <button type="button" class="bg-primary text-primary-fg border-none px-4 py-1.5 rounded-full text-sm font-semibold cursor-pointer hover:bg-primary-hover" data-action="click->info#close">Close</button>
        </div>
      </div>
    </div>
  </div>
</header>
