#!/usr/bin/env python3
"""Assemble only the requested artifacts in a fresh staging directory; never publish."""
import argparse
import hashlib
import json
import pathlib
import shutil
import subprocess
import tarfile
import tempfile

root = pathlib.Path(__file__).resolve().parent.parent
parser = argparse.ArgumentParser()
parser.add_argument('--gem', action='store_true')
options = parser.parse_args()
version = json.loads((root / 'desktop/electron/package.json').read_text())['version']
kind = 'gem' if options.gem else 'desktop'
destination = root / 'pkg/release' / version / kind
destination.parent.mkdir(parents=True, exist_ok=True)


def assemble(release):
    if options.gem:
        gem_version = subprocess.check_output(
            ['bundle', 'exec', 'ruby', '-Ilib', '-rinvasion_studio/version', '-rrubygems',
             '-e', 'print Gem::Version.new(InvasionStudio::VERSION)'], cwd=root, text=True)
        artifact = root / f'invasion-studio-{gem_version}.gem'
        shutil.copy2(artifact, release / artifact.name)
    else:
        artifact = root / 'desktop/electron/out/make/flatpak/x86_64/com.bladeofmaya.InvasionStudio_stable_x86_64.flatpak'
        shutil.copy2(artifact, release / f'invasion-studio-{version}-linux-x64.flatpak')
        collect_media_sources(release)
        shutil.copy2(root / 'pkg/sidecar/linux-x64/dependencies.json', release / 'backend-dependencies.json')
    for name in ['MIT-LICENSE', 'THIRD_PARTY_LICENSES.md', 'RELEASING.md', 'CHANGELOG.md']:
        shutil.copy2(root / name, release / name)
    provenance = {
        'version': version, 'kind': kind,
        'source_revision': subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=root, text=True).strip(),
        'source_dirty': bool(subprocess.check_output(['git', 'status', '--porcelain'], cwd=root, text=True).strip())
    }
    if not options.gem:
        provenance['backend'] = json.loads((root / 'pkg/sidecar/linux-x64/build-info.json').read_text())
        provenance['flatpak_refs'] = {
            ref: subprocess.check_output(['flatpak', 'info', '--show-commit', ref], text=True).strip()
            for ref in ['org.freedesktop.Platform//26.08', 'org.freedesktop.Sdk//26.08', 'org.electronjs.Electron2.BaseApp//26.08']
        }
    (release / 'build-info.json').write_text(json.dumps(provenance, indent=2) + '\n')
    files = sorted(p for p in release.iterdir() if p.is_file())
    (release / 'SHA256SUMS').write_text(''.join(
        f'{hashlib.sha256(p.read_bytes()).hexdigest()}  {p.name}\n' for p in files))


def collect_media_sources(release):
    modules = json.loads((root / 'desktop/flatpak/media-modules.json').read_text())
    cache = root / 'pkg/release-sources'
    cache.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix='invasion-sources-') as temporary:
        stage = pathlib.Path(temporary)
        for module in modules:
            destination = stage / module['name']
            destination.mkdir()
            for source in module['sources']:
                name = source['url'].split('/')[-1]
                cached = cache / (source['sha256'] + '-' + name)
                if not cached.exists():
                    subprocess.run(['curl', '--fail', '--location', '--retry', '2', source['url'], '-o', str(cached)], check=True)
                if hashlib.sha256(cached.read_bytes()).hexdigest() != source['sha256']:
                    raise SystemExit(f'Checksum mismatch: {cached}; remove it and retry')
                shutil.copy2(cached, destination / name)
        shutil.copy2(root / 'desktop/flatpak/media-modules.json', stage / 'media-modules.json')
        (stage / 'README.txt').write_text(
            'Unmodified sources for the Invasion Studio media tools. Build instructions and options\n'
            'are in media-modules.json (flatpak-builder, Freedesktop SDK 26.08).\n'
            'Replace source URLs with these local archives, retaining their SHA-256 checksums.\n'
            'FFmpeg is LGPL-2.1-or-later; build without --enable-gpl or --enable-nonfree.\n'
            'The application source release also contains script/build-desktop and the Forge configuration.\n')
        with tarfile.open(release / f'invasion-studio-{version}-media-sources.tar.gz', 'w:gz') as archive:
            archive.add(stage, arcname='media-sources')

with tempfile.TemporaryDirectory(prefix=f'.{kind}-', dir=destination.parent) as temporary:
    staged = pathlib.Path(temporary) / kind
    staged.mkdir()
    assemble(staged)
    # Only replace the generated target after every artifact has been collected.
    previous = pathlib.Path(temporary) / 'previous'
    if destination.exists():
        destination.rename(previous)
    try:
        staged.rename(destination)
    except BaseException:
        if previous.exists():
            previous.rename(destination)
        raise
print(f'Release candidates: {destination}')
