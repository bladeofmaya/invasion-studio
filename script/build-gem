#!/usr/bin/env bash
set -euo pipefail
IFS=$'\n\t'

PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$PROJECT_DIR"

script/build-assets
bundle exec gem build invasion-studio.gemspec
script/verify-gem "invasion-studio-$(bundle exec ruby -Ilib -rinvasion_studio/version -rrubygems -e 'print Gem::Version.new(InvasionStudio::VERSION)').gem"
