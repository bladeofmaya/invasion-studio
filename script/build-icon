#!/usr/bin/env bash
set -euo pipefail
IFS=$'\n\t'

if [ "$#" -ne 0 ]; then
  echo "Usage: bin/dev icon" >&2
  exit 2
fi

PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ASSETS_DIR="$PROJECT_DIR/desktop/electron/assets"
LOGO="$ASSETS_DIR/logo.png"

command -v magick >/dev/null || {
  echo "ImageMagick 7 is required (the magick command)." >&2
  exit 1
}
if [ ! -f "$LOGO" ]; then
  echo "Logo not found: $LOGO" >&2
  exit 1
fi

# Fit without stretching or cropping; pad non-square logos with transparency.
magick "$LOGO" -auto-orient -resize 512x512 \
  -background none -gravity center -extent 512x512 \
  "$ASSETS_DIR/app-icon.png"
cp "$LOGO" "$ASSETS_DIR/app-icon-master.png"

cat > "$ASSETS_DIR/app-icon-prompt.txt" <<'EOF'
Generated by bin/dev icon using ImageMagick, without AI generation.

Source: logo.png (copied unchanged to app-icon-master.png).
Output: app-icon.png, resized proportionally to fit a 512x512 transparent canvas.
The artwork is centered without cropping or stretching.
EOF

echo "Updated app-icon.png and app-icon-master.png from logo.png."
echo "Run bin/release --install to rebuild and reinstall the app."
