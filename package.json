{
  "name": "invasion-studio-assets",
  "private": true,
  "scripts": {
    "test": "node --test test/frontend/*.test.mjs",
    "build": "npm run build:css && npm run build:js",
    "build:css": "tailwindcss -i lib/invasion_studio/webui/frontend/app.css -o lib/invasion_studio/webui/public/assets/app.css --minify",
    "build:js": "esbuild lib/invasion_studio/webui/frontend/app.js lib/invasion_studio/webui/frontend/player-prototype.js --bundle --format=esm --minify --outdir=lib/invasion_studio/webui/public/assets"
  },
  "devDependencies": {
    "@hotwired/stimulus": "3.2.2",
    "@tailwindcss/cli": "4.3.3",
    "esbuild": "0.28.1",
    "tailwindcss": "4.3.3"
  },
  "dependencies": {
    "@videojs/html": "10.0.0-rc.4",
    "lucide": "1.27.0",
    "sortablejs": "1.15.7"
  }
}
