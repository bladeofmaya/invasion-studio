#!/usr/bin/env bash
set -euo pipefail
IFS=$'\n\t'

if [ "$#" -ne 0 ]; then
  echo "Usage: bin/install-desktop" >&2
  exit 2
fi

PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
FLATPAK_BUNDLE="$PROJECT_DIR/desktop/electron/out/make/flatpak/x86_64/com.bladeofmaya.InvasionStudio_stable_x86_64.flatpak"

command -v flatpak >/dev/null || { echo "Flatpak is required." >&2; exit 1; }

"$PROJECT_DIR/bin/build-desktop" --make

if [ ! -f "$FLATPAK_BUNDLE" ]; then
  echo "Build did not produce the expected Flatpak: $FLATPAK_BUNDLE" >&2
  exit 1
fi

flatpak install --user --reinstall --noninteractive "$FLATPAK_BUNDLE"

echo "Invasion Studio installed. Close any running instance, then launch:"
echo "  flatpak run com.bladeofmaya.InvasionStudio"
