#!/usr/bin/env ruby
# frozen_string_literal: true

require 'json'

# Bump the gem version and refresh Gemfile.lock.
#
#   bin/bump-version patch      0.6.0 -> 0.6.1
#   bin/bump-version minor      0.6.0 -> 0.7.0
#   bin/bump-version major      0.6.0 -> 1.0.0
#   bin/bump-version 1.2.3      set an explicit version
#   bin/bump-version v1.2.3-dev set an explicit prerelease version

VERSION_FILE = File.expand_path('../lib/invasion_studio/version.rb', __dir__)
ELECTRON_PACKAGE_FILE = File.expand_path('../desktop/electron/package.json', __dir__)
ELECTRON_LOCK_FILE = File.expand_path('../desktop/electron/package-lock.json', __dir__)
GEM_LOCK_FILE = File.expand_path('../Gemfile.lock', __dir__)

arg = ARGV.fetch(0) do
  warn 'Usage: bin/bump-version patch|minor|major|[v]X.Y.Z[-PRERELEASE]'
  exit 2
end

contents = File.read(VERSION_FILE)
version_pattern = /\d+\.\d+\.\d+(?:-[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?/
current = contents[/VERSION = "(#{version_pattern})"/, 1]
abort "Could not find VERSION in #{VERSION_FILE}" unless current

new_version =
  case arg
  when 'patch', 'minor', 'major'
    major, minor, patch = current.split('-', 2).first.split('.').map(&:to_i)
    case arg
    when 'patch' then "#{major}.#{minor}.#{patch + 1}"
    when 'minor' then "#{major}.#{minor + 1}.0"
    when 'major' then "#{major + 1}.0.0"
    end
  when /\Av?#{version_pattern}\z/
    arg.delete_prefix('v')
  else
    abort "Invalid argument: #{arg.inspect} (expected patch, minor, major, or [v]X.Y.Z[-PRERELEASE])"
  end

File.write(VERSION_FILE, contents.sub("\"#{current}\"", "\"#{new_version}\""))

[ELECTRON_PACKAGE_FILE, ELECTRON_LOCK_FILE].each do |path|
  data = JSON.parse(File.read(path))
  data['version'] = new_version
  root_package = data.dig('packages', '')
  root_package['version'] = new_version if root_package
  File.write(path, "#{JSON.pretty_generate(data)}\n")
end
puts "Version: #{current} -> #{new_version}"

Dir.chdir(File.expand_path('..', __dir__)) do
  lock_contents = File.read(GEM_LOCK_FILE)
  bundler_version = lock_contents[/BUNDLED WITH\s+(\S+)/, 1]
  abort "Could not find BUNDLED WITH in #{GEM_LOCK_FILE}" unless bundler_version

  system('bundle', "_#{bundler_version}_", 'lock', exception: true)
end
puts 'Gemfile.lock refreshed.'
puts 'Electron package metadata refreshed.'

puts
puts 'Next steps:'
puts '  bin/release-check'
puts "  git commit -am \"bump version to #{new_version}\" && git tag v#{new_version}"
